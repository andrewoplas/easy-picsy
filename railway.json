{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "node apps/backend/dist/main.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  },
  "variables": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "NODE_VERSION": "20"
  }
}