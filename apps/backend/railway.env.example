# Railway Environment Variables Template
# Copy this file and set the values in your Railway dashboard

# Application Configuration
NODE_ENV=production
PORT=3000
API_PREFIX=api
API_VERSION=v1

# Database (Railway will provide this automatically when you add PostgreSQL)
DATABASE_URL=postgresql://postgres:password@containers-us-west-1.railway.app:5432/railway

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRATION=7d

# CORS Configuration (set to your frontend domain in production)
CORS_ORIGIN=https://your-frontend-domain.com

# PayMongo Configuration (optional - for payment processing)
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_your_paymongo_public_key
