{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "target": "es2022",
    "customConditions": ["development"],
    "paths": {
      "@org/api-lib": ["libs/api-lib/index.ts"],
      "@org/api-lib/*": ["libs/api-lib/*"],
      "@org/commons": ["libs/commons/src/index.ts"],
      "@org/commons/*": ["libs/commons/src/*"]
    }
  }
}
