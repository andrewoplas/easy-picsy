## Component Structure

```typescript
// ✅ DO: Use proper type imports
import type { ReactNode } from 'react';

// ✅ DO: Use descriptive interface names
interface ActivityTimelineProps {
  sessionId: string;
  activities: BoothActivity[];
  isExpanded?: boolean;
  onToggle: (id: string) => void;
}

// ✅ DO: Use function keyword for components
export function ActivityTimeline({
  sessionId,
  activities,
  isExpanded = false,
  onToggle,
}: ActivityTimelineProps) {
  // 1. Hooks (useState, useEffect, custom hooks)
  const [selectedActivity, setSelectedActivity] = useState<string | null>(null);
  const { data, isLoading } = useEventActivity(sessionId);

  // 2. Derived state and callbacks
  const sortedActivities = useMemo(() => 
    activities.sort((a, b) => 
      new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()
    ),
    [activities]
  );

  const handleActivitySelect = useCallback((id: string) => {
    setSelectedActivity(id);
    onToggle(id);
  }, [onToggle]);

  // 3. Effects
  useEffect(() => {
    if (data) {
      // Handle data updates
    }
  }, [data]);

  // 4. Render helpers
  const renderActivity = (activity: BoothActivity) => (
    <ActivityItem
      key={activity.id}
      activity={activity}
      isSelected={activity.id === selectedActivity}
      onSelect={handleActivitySelect}
    />
  );

  // 5. Loading/error states
  if (isLoading) {
    return <ActivitySkeleton />;
  }

  // 6. Main render
  return (
    <div className="space-y-4">
      {sortedActivities.map(renderActivity)}
    </div>
  );
}
```

