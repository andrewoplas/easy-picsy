# API Integration Guidelines

## API Service Structure

```typescript
// ✅ DO: Create typed API services
// @/lib/api/events.ts
import { Configuration, EventsApi } from '@org/api-lib';
import { Event, CreateEventDto } from '@org/commons';
import axiosInstance from './client';

const config = new Configuration();
const eventsApiInstance = new EventsApi(
  config,
  undefined,
  axiosInstance
);

export const eventsApi = {
  async getById(id: string): Promise<Event> {
    const response = await eventsApiInstance
      .eventsControllerGetById(id);
    return response.data;
  },

  async create(data: CreateEventDto): Promise<Event> {
    const response = await eventsApiInstance
      .eventsControllerCreate(data);
    return response.data;
  },
};
```

## React Query Integration

```typescript
// ✅ DO: Create reusable query hooks
// @/hooks/useEvent.ts
import { useQuery, useMutation } from '@tanstack/react-query';
import { eventsApi } from '@/lib/api/events';
import type { Event, CreateEventDto } from '@org/commons';

export const EVENT_QUERY_KEYS = {
  all: ['events'] as const,
  lists: () => [...EVENT_QUERY_KEYS.all, 'list'] as const,
  list: (filters: string) => [...EVENT_QUERY_KEYS.lists(), { filters }] as const,
  details: () => [...EVENT_QUERY_KEYS.all, 'detail'] as const,
  detail: (id: string) => [...EVENT_QUERY_KEYS.details(), id] as const,
} as const;

export function useEvent(id: string) {
  return useQuery({
    queryKey: EVENT_QUERY_KEYS.detail(id),
    queryFn: () => eventsApi.getById(id),
    staleTime: 30 * 1000, // 30 seconds
  });
}

export function useCreateEvent() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: (data: CreateEventDto) => 
      eventsApi.create(data),
    onSuccess: () => {
      queryClient.invalidateQueries({
        queryKey: EVENT_QUERY_KEYS.lists(),
      });
    },
  });
}
```

## Error Handling

```typescript
// ✅ DO: Create typed error handling
// @/lib/api/errors.ts
export class ApiError extends Error {
  constructor(
    message: string,
    public status: number,
    public code: string
  ) {
    super(message);
    this.name = 'ApiError';
  }
}

// @/lib/api/client.ts
import axios from 'axios';

const axiosInstance = axios.create({
  baseURL: process.env.NEXT_PUBLIC_API_URL,
});

axiosInstance.interceptors.response.use(
  response => response,
  error => {
    if (error.response) {
      throw new ApiError(
        error.response.data.message,
        error.response.status,
        error.response.data.code
      );
    }
    throw error;
  }
);

export default axiosInstance;
```

## Real-time Updates

```typescript
// ✅ DO: Implement real-time updates with React Query
// @/hooks/useEventActivity.ts
export function useEventActivity(eventId: string) {
  const { data, ...rest } = useQuery({
    queryKey: ['activity', eventId],
    queryFn: () => activityApi.getBoothLogs(eventId),
    refetchInterval: 30 * 1000, // Poll every 30 seconds
  });

  useEffect(() => {
    const ws = new WebSocket(
      `${process.env.NEXT_PUBLIC_WS_URL}/events/${eventId}`
    );

    ws.onmessage = (event) => {
      const activity = JSON.parse(event.data);
      queryClient.setQueryData(
        ['activity', eventId],
        (old: BoothActivity[]) => [...old, activity]
      );
    };

    return () => ws.close();
  }, [eventId]);

  return { data, ...rest };
}
```

