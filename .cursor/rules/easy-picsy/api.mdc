```typescript
// ✅ DO: Transform API data consistently
// @/lib/api/transforms.ts
import { BoothLog, BoothActivity } from '@org/commons';

export function transformBoothLog(log: BoothLog): BoothActivity {
  return {
    id: log.id,
    type: log.boothEventType,
    timestamp: log.timestamp,
    description: formatBoothEvent(log),
    status: log.status,
  };
}

// @/lib/api/activity.ts
export const activityApi = {
  async getBoothLogs(eventId: string): Promise<BoothActivity[]> {
    const response = await boothLoggingApiInstance
      .boothLoggingControllerGetBoothEvents(eventId);
    
    return response.data.map(transformBoothLog);
  },
};
```

## Authentication & Authorization

```typescript
// ✅ DO: Handle auth in API client
// @/lib/api/client.ts
import { getSession } from 'next-auth/react';

axiosInstance.interceptors.request.use(
  async config => {
    const session = await getSession();
    
    if (session?.accessToken) {
      config.headers.Authorization = 
        `Bearer ${session.accessToken}`;
    }
    
    return config;
  },
  error => Promise.reject(error)
);

// Handle token refresh
axiosInstance.interceptors.response.use(
  response => response,
  async error => {
    const originalRequest = error.config;

    if (error.response?.status === 401 && !originalRequest._retry) {
      originalRequest._retry = true;
      
      const newToken = await refreshAccessToken();
      
      originalRequest.headers.Authorization = 
        `Bearer ${newToken}`;
        
      return axiosInstance(originalRequest);
    }

    return Promise.reject(error);
  }
);
```

## API Testing

```typescript
// ✅ DO: Test API integration
// @/hooks/useEvent.test.ts
import { renderHook, waitFor } from '@testing-library/react';
import { useEvent } from './useEvent';
import { eventsApi } from '@/lib/api/events';

vi.mock('@/lib/api/events');

describe('useEvent', () => {
  it('fetches and returns event data', async () => {
    const mockEvent = {
      id: '123',
      name: 'Test Event',
    };

    (eventsApi.getById as Mock).mockResolvedValue(mockEvent);

    const { result } = renderHook(() => 
      useEvent('123')
    );

    expect(result.current.isLoading).toBe(true);

    await waitFor(() => {
      expect(result.current.isSuccess).toBe(true);
    });

    expect(result.current.data).toEqual(mockEvent);
  });

  it('handles errors properly', async () => {
    const error = new ApiError(
      'Not found',
      404,
      'EVENT_NOT_FOUND'
    );

    (eventsApi.getById as Mock).mockRejectedValue(error);

    const { result } = renderHook(() => 
      useEvent('123')
    );

    await waitFor(() => {
      expect(result.current.isError).toBe(true);
    });

    expect(result.current.error).toEqual(error);
  });
});
```

## Performance Optimization

```typescript
// ✅ DO: Optimize data fetching
export function useEventDashboard(eventId: string) {
  // Parallel queries
  const queries = useQueries({
    queries: [
      {
        queryKey: ['event', eventId],
        queryFn: () => eventsApi.getById(eventId),
      },
      {
        queryKey: ['analytics', eventId],
        queryFn: () => analyticsApi.getEventAnalytics(eventId),
      },
      {
        queryKey: ['activity', eventId],
        queryFn: () => activityApi.getBoothLogs(eventId),
      },
    ],
  });

  // Derived state
  const data = useMemo(() => {
    if (queries.some(q => !q.data)) return null;
    
    return {
      event: queries[0].data,
      analytics: queries[1].data,
      activity: queries[2].data,
    };
  }, [queries]);

  return {
    data,
    isLoading: queries.some(q => q.isLoading),
    error: queries.find(q => q.error)?.error,
  };
}
```

## API Documentation

```typescript
// ✅ DO: Document API integration
/**
 * Hook for managing event data
 * @param id - The event ID to fetch
 * @returns Query result with event data
 * @throws {ApiError} When the event is not found or server error occurs
 * @example
 * ```tsx
 * function EventDetails({ id }: { id: string }) {
 *   const { data, isLoading } = useEvent(id);
 *   
 *   if (isLoading) return <Spinner />;
 *   return <div>{data.name}</div>;
 * }
 * ```
 */
export function useEvent(id: string) {
  return useQuery({
    queryKey: EVENT_QUERY_KEYS.detail(id),
    queryFn: () => eventsApi.getById(id),
  });
}
```

