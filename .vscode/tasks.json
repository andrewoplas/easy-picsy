{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🌐 Start Frontend",
      "type": "shell",
      "command": "npx",
      "args": ["nx", "serve", "frontend"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
